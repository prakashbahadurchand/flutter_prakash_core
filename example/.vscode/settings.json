{
  "dart.flutterSdkPath": ".fvm/versions/3.44.9",
  "dart.lineLength": 80,
  "dart.openDevTools": "never",
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "dart.closingLabels": true,
  "dart.runPubGetOnPubspecChanges": "prompt",
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.warnWhenEditingFilesOutsideWorkspace": true,
  "dart.showTodos": true,
  "dart.enableSnippets": true,
  "dart.updateImportsOnRename": true,
  "java.configuration.updateBuildConfiguration": "disabled",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": true,
  "editor.minimap.maxColumn": 80,
  "editor.wordWrap": "off",
  "editor.linkedEditing": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.snippetSuggestions": "bottom",
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontLigatures": false,
  "editor.renderWhitespace": "trailing",
  "editor.accessibilitySupport": "off",
  "files.autoSave": "onWindowChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/*.freezed.dart": true,
    "**/*.g.dart": true,
    "**/*.config.dart": true,
    "**/*.gr.dart": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/.fvm/**": true,
    "**/.idea/**": true,
    "**/.antigravity/**": true,
    "**/.ruby-lsp/**": true,
    "Icon**": true,
    "vendor/bundle": true
  },
  "search.exclude": {
    "**/*.freezed.dart": true,
    "**/*.g.dart": true,
    "**/*.gr.dart": true,
    "**/*.config.dart": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/.fvm/**": true,
    "vendor/bundle": true,
    "**/ios/Pods/**": true,
    "**/android/.gradle/**": true
  },
  "search.useIgnoreFiles": true,
  "search.smartCase": true,
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/.fvm/**": true,
    "**/ios/Pods/**": true,
    "**/android/.gradle/**": true,
    "vendor/bundle": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "explorer.compactFolders": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.scrollback": 10000,
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.renderSideBySide": true,
  "workbench.sideBar.location": "left",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.enablePreview": true,
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 8,
  "debug.openDebug": "openOnDebugBreak",
  "debug.internalConsoleOptions": "openOnSessionStart",
  "debug.toolBarLocation": "floating",
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.decorations.enabled": true,
  "git.inputValidationSubjectLength": 72,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": "pubspec.lock, pubspec_overrides.yaml, .metadata, .fvmrc, analysis_options.yaml, l10n.yaml, build.yaml, .flutter-plugins-dependencies, flutter_launcher_icons-dev.yaml, flutter_launcher_icons-prod.yaml, flutter_native_splash-dev.yaml, flutter_native_splash-prod.yaml, devtools_options.yaml, firebase.sh, .firebaserc, firebase.json, loverg.iml, flutter_gen.yaml, firebase_setup.sh",
    ".gitignore": ".gitattributes, .gitmodules",
    "*.dart": "$(capture).g.dart, $(capture).freezed.dart, $(capture).template.dart, $(capture).config.dart",
    ".env.dev": ".env*"
  },
  "files.associations": {
    "*.arb": "json"
  },
  "emmet.includeLanguages": {
    "dart": "html"
  },
  "telemetry.telemetryLevel": "off",
  "java.compile.nullAnalysis.mode": "automatic"
}